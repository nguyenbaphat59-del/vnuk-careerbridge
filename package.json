{
  "name": "vnuk-CareerBridge-demo",
  "version": "1.0.0",
  "private": true,
  "description": "VNUK CareerBridge — personalised internship preparation planner and full-stack demo",
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "test:server": "npm --prefix server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
